<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin launcher for tools/generation-persistence-probe: builds the probe and
    calls it in-process, so one command drives a case without retyping a long
    dotnet invocation.

    Usage (arguments after the separator are handed to the probe unchanged):
      dotnet run (project tools/run-generation-probe, -p:QuriousDll=path)
        (separator) (probe args: workdir, mode, live-a, live-b)

    The probe project stays the single owner of the checks; this project adds
    no logic of its own. QuriousDll / Sts2DataDir / BaseLibDll are MSBuild
    GLOBAL properties, so they reach the referenced probe project unchanged and
    the probe's own defaults stay in force when they are not supplied.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RunGenerationProbe</AssemblyName>
    <RootNamespace>RunGenerationProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../generation-persistence-probe/GenerationPersistenceProbe.csproj" />
  </ItemGroup>

</Project>
